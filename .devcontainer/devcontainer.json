{
  "name": "TC3 GPU",
  "dockerComposeFile": "../compose.yaml",
  "service": "notebook-gpu",
  "runServices": ["notebook-gpu"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python"
      }
    }
  }
}
